{
  "name": "schleuderwerk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Schleuderwerk – Launch-&-Bastel-Spiel",
  "scripts": {
    "test": "node --test tests/",
    "smoke": "node tools/smoke.mjs",
    "build:pc": "node tools/build-pc.mjs",
    "smoke:pc": "node tools/smoke-pc.mjs",
    "serve": "python tools/serve.py",
    "android:prepare": "npx cap add android && node tools/patch-android.mjs && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:build": "cd android && gradlew assembleDebug",
    "playtest": "node tools/playtest/goals.mjs --n 12 && node tools/playtest/synergy.mjs --n 8 --runs 12 && node tools/sim/progression.mjs --careers 8"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.25.10"
  }
}
